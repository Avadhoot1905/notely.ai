# === Rust ===
/target/
**/*.rs.bk

# === Flutter / Dart ===
apps/desktop/.dart_tool/
apps/desktop/.flutter-plugins
apps/desktop/.flutter-plugins-dependencies
apps/desktop/build/
apps/desktop/.pub-cache/
apps/desktop/.pub/
apps/desktop/ios/
apps/desktop/android/
apps/desktop/linux/
apps/desktop/web/
**/Flutter/ephemeral/
**/Pods/

# === Models (weights are NEVER committed — only manifests under models/manifests/) ===
# Everything under models/ is ignored EXCEPT the README and the manifests.
models/**
!models/README.md
!models/manifests/
!models/manifests/**

# === Model weight / inference artifact formats (never versioned here) ===
# Explicit formats rather than broad patterns, so real source is never accidentally hidden.
*.gguf
*.safetensors
*.bin
*.pt
*.pth
*.onnx
*.ckpt
*.npz
# Local runtime stores / inference caches (Ollama, HF, llama.cpp, ASR runtime, etc.).
.ollama/
**/ollama/models/
.cache/huggingface/
**/*.llamafile
# Qwen3-ASR / other ASR runtime caches and their local model stores.
.qwen-asr/
**/asr-cache/
*.mlmodelc

# === Local Notely runtime + generated data (lives outside the repo, but guard anyway) ===
# Databases and app data.
*.sqlite
*.sqlite3
*.db
*.db-wal
*.db-shm
/data/runtime/
# Generated embeddings / temporary inference files.
*.embeddings
*.embeddings.json
*.tmp.wav
*.partial

# === Generated media / transcripts / Meeting IR (keep curated fixtures; ignore runtime output) ===
data/fixtures/audio/*
!data/fixtures/audio/.gitkeep
# Ad-hoc generated audio / transcripts / Meeting IR / MOMs produced at runtime.
/data/generated/
*.generated.json
*.mom.md
# Recorded/normalized audio produced by the media stage (no audio is committed for v0).
*.wav
*.m4a
*.mp3
*.flac

# === Editors / OS ===
.DS_Store
.idea/
.vscode/
*.swp

# === Env / secrets ===
.env
.env.*
!.env.example
