{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://notely.ai/schema/ipc.schema.json",
  "title": "Notely IPC protocol",
  "description": "Canonical, language-neutral schema for the Flutter <-> Rust IPC contract. Mirrored by engine/src/ipc (the source of truth) and apps/desktop/lib/ipc. See packages/protocol/README.md. Transport: newline-delimited JSON over a loopback TCP socket (default 127.0.0.1:8765). Requests are wrapped in a RequestEnvelope { protocol_version, request_id, ...Request }; responses in a ResponseEnvelope { protocol_version, request_id, ...Response }; events in an EventEnvelope { protocol_version, event: Event }.",
  "protocolVersion": 3,
  "definitions": {
    "ProcessInput": {
      "description": "What to process into a meeting. Tagged by `kind`.",
      "oneOf": [
        { "properties": { "kind": { "const": "transcript" }, "title": { "type": ["string", "null"] }, "transcript": { "$ref": "#/definitions/Transcript" } }, "required": ["kind", "transcript"] },
        { "properties": { "kind": { "const": "audio" }, "title": { "type": ["string", "null"] }, "path": { "type": "string" } }, "required": ["kind", "path"] }
      ]
    },
    "Request": {
      "description": "Flutter -> Engine commands. Tagged by `type`; variants with data carry a `params` object (unit variants like Health carry no `params`).",
      "oneOf": [
        { "properties": { "type": { "const": "Health" } }, "required": ["type"] },
        { "properties": { "type": { "const": "ProcessMeeting" }, "params": { "properties": { "input": { "$ref": "#/definitions/ProcessInput" } }, "required": ["input"] } }, "required": ["type", "params"] },
        { "properties": { "type": { "const": "GetJob" }, "params": { "properties": { "job_id": { "type": "string" } }, "required": ["job_id"] } }, "required": ["type", "params"] },
        { "properties": { "type": { "const": "CancelJob" }, "params": { "properties": { "job_id": { "type": "string" } }, "required": ["job_id"] } }, "required": ["type", "params"] },
        { "properties": { "type": { "const": "GetMeeting" }, "params": { "properties": { "meeting_id": { "type": "string" } }, "required": ["meeting_id"] } }, "required": ["type", "params"] },
        { "properties": { "type": { "const": "GetTranscript" }, "params": { "properties": { "meeting_id": { "type": "string" } }, "required": ["meeting_id"] } }, "required": ["type", "params"] },
        { "properties": { "type": { "const": "GetMom" }, "params": { "properties": { "meeting_id": { "type": "string" } }, "required": ["meeting_id"] } }, "required": ["type", "params"] },
        { "properties": { "type": { "const": "Search" }, "params": { "properties": { "query": { "type": "string" }, "vault_path": { "type": "string" }, "limit": { "type": ["integer", "null"] } }, "required": ["query", "vault_path"] } }, "required": ["type", "params"] },
        { "properties": { "type": { "const": "Ask" }, "params": { "properties": { "question": { "type": "string" }, "vault_path": { "type": "string" } }, "required": ["question", "vault_path"] } }, "required": ["type", "params"] },
        { "properties": { "type": { "const": "ListMeetings" } }, "required": ["type"] },
        { "properties": { "type": { "const": "ReprocessMeeting" }, "params": { "properties": { "meeting_id": { "type": "string" } }, "required": ["meeting_id"] } }, "required": ["type", "params"] }
      ]
    },
    "Response": {
      "description": "Immediate engine response. Tagged by `type` with a `data` payload. Long work continues via Event.",
      "oneOf": [
        { "properties": { "type": { "const": "Health" }, "data": { "$ref": "#/definitions/HealthInfo" } }, "required": ["type", "data"] },
        { "properties": { "type": { "const": "JobAccepted" }, "data": { "properties": { "job_id": { "type": "string" } }, "required": ["job_id"] } }, "required": ["type", "data"] },
        { "properties": { "type": { "const": "Job" }, "data": { "$ref": "#/definitions/Job" } }, "required": ["type", "data"] },
        { "properties": { "type": { "const": "Meeting" }, "data": { "$ref": "#/definitions/Meeting" } }, "required": ["type", "data"] },
        { "properties": { "type": { "const": "Transcript" }, "data": { "$ref": "#/definitions/Transcript" } }, "required": ["type", "data"] },
        { "properties": { "type": { "const": "Mom" }, "data": { "properties": { "markdown": { "type": "string" } }, "required": ["markdown"] } }, "required": ["type", "data"] },
        { "properties": { "type": { "const": "SearchResults" }, "data": { "type": "array", "items": { "$ref": "#/definitions/SearchHit" } } }, "required": ["type", "data"] },
        { "properties": { "type": { "const": "Answer" }, "data": { "$ref": "#/definitions/AskAnswer" } }, "required": ["type", "data"] },
        { "properties": { "type": { "const": "MeetingList" }, "data": { "type": "array", "items": { "$ref": "#/definitions/MeetingSummary" } } }, "required": ["type", "data"] },
        { "properties": { "type": { "const": "Error" }, "data": { "properties": { "message": { "type": "string" } }, "required": ["message"] } }, "required": ["type", "data"] }
      ]
    },
    "Event": {
      "description": "Engine -> Flutter async job progress/lifecycle events. Tagged by `type` with a `data` payload that always includes `job_id`.",
      "properties": {
        "type": {
          "enum": [
            "JobCreated",
            "ProcessingStarted",
            "MediaProcessingStarted",
            "MediaProcessingCompleted",
            "TranscriptionStarted",
            "TranscriptionProgress",
            "TranscriptionCompleted",
            "ChunkingStarted",
            "ChunkingCompleted",
            "ExtractionStarted",
            "ExtractionProgress",
            "ExtractionCompleted",
            "SynthesisStarted",
            "SynthesisCompleted",
            "ValidationStarted",
            "ValidationCompleted",
            "RenderingStarted",
            "RenderingCompleted",
            "JobCompleted",
            "JobFailed"
          ]
        },
        "data": {
          "type": "object",
          "properties": {
            "job_id": { "type": "string" },
            "meeting_id": { "type": "string" },
            "progress": { "type": "number" },
            "completed": { "type": "integer" },
            "total": { "type": "integer" },
            "chunk_count": { "type": "integer" },
            "message": { "type": "string" }
          },
          "required": ["job_id"]
        }
      },
      "required": ["type", "data"]
    },
    "HealthInfo": {
      "properties": {
        "protocol_version": { "type": "integer" },
        "engine_ok": { "type": "boolean" },
        "llm_ok": { "type": "boolean" },
        "model": { "type": "string" },
        "asr_provider": { "type": "string" }
      },
      "required": ["protocol_version", "engine_ok", "llm_ok", "model", "asr_provider"]
    },
    "Job": {
      "properties": {
        "id": { "type": "string" },
        "status": { "enum": ["queued", "running", "completed", "failed", "cancelled"] },
        "stage": { "enum": ["created", "media_processing", "transcription", "chunking", "extraction", "synthesis", "validation", "rendering", "storing", "done"] },
        "meeting_id": { "type": "string" },
        "error": { "type": "string" }
      },
      "required": ["id", "status", "stage"]
    },
    "Meeting": {
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "occurred_at": { "type": "string", "format": "date-time" },
        "participants": { "type": "array", "items": { "$ref": "#/definitions/Participant" } },
        "duration_seconds": { "type": "number" }
      },
      "required": ["id", "title", "created_at"]
    },
    "Participant": {
      "properties": {
        "id": { "type": "string" },
        "display_name": { "type": "string" }
      },
      "required": ["id"]
    },
    "Transcript": {
      "properties": {
        "segments": { "type": "array", "items": { "$ref": "#/definitions/TranscriptSegment" } }
      },
      "required": ["segments"]
    },
    "TranscriptSegment": {
      "properties": {
        "speaker_id": { "type": "string" },
        "start": { "type": "number" },
        "end": { "type": "number" },
        "text": { "type": "string" },
        "language": { "type": "string" },
        "confidence": { "type": "number" }
      },
      "required": ["start", "end", "text"]
    },
    "SearchHit": {
      "description": "A ranked passage matched by a Search. Line indices are 0-based, inclusive.",
      "properties": {
        "path": { "type": "string" },
        "title": { "type": "string" },
        "start_line": { "type": "integer" },
        "end_line": { "type": "integer" },
        "snippet": { "type": "string" }
      },
      "required": ["path", "title", "start_line", "end_line", "snippet"]
    },
    "Citation": {
      "description": "A cited passage backing an AskAnswer. Line indices are 0-based, inclusive.",
      "properties": {
        "path": { "type": "string" },
        "start_line": { "type": "integer" },
        "end_line": { "type": "integer" },
        "snippet": { "type": "string" }
      },
      "required": ["path", "start_line", "end_line", "snippet"]
    },
    "AskAnswer": {
      "description": "A source-grounded answer. `text` may contain `[n]` markers (1-based) referencing `citations`.",
      "properties": {
        "text": { "type": "string" },
        "files_read": { "type": "array", "items": { "type": "string" } },
        "citations": { "type": "array", "items": { "$ref": "#/definitions/Citation" } }
      },
      "required": ["text", "files_read", "citations"]
    },
    "ProcessingStatus": {
      "description": "Durable state of a capture's AI enrichment (operational metadata, stored separately from the source).",
      "properties": {
        "state": { "enum": ["processing", "ready", "deferred", "failed"] },
        "failure_kind": { "enum": ["temporary", "permanent"] },
        "error": { "type": "string" },
        "updated_at": { "type": "string", "format": "date-time" }
      },
      "required": ["state", "updated_at"]
    },
    "MeetingSummary": {
      "description": "A captured meeting paired with its processing status — the unit the Inbox lists.",
      "properties": {
        "meeting": { "$ref": "#/definitions/Meeting" },
        "status": { "$ref": "#/definitions/ProcessingStatus" }
      },
      "required": ["meeting"]
    }
  }
}
