# Example Notely engine configuration. Copy to `.env` (git-ignored) and adjust locally.
# All variables are optional; the engine has sensible local-first defaults.

# --- LLM (meeting understanding) — served by Ollama ---
NOTELY_OLLAMA_URL=http://localhost:11434
# The semantic model tag (see models/manifests/qwen3.yaml). Default: qwen3:1.7b.
# Configurable so you can benchmark qwen3:0.6b / qwen3:4b without changing the pipeline.
NOTELY_LLM_MODEL=qwen3:1.7b
# Timeout for a single LLM generation, in seconds.
NOTELY_OLLAMA_TIMEOUT_SECS=180

# --- ASR (speech recognition) — a SEPARATE runtime, NOT Ollama ---
# Provider: qwen3-asr (default) | whisper | fixture.
NOTELY_ASR_PROVIDER=qwen3-asr
# Base URL of the Qwen3-ASR runtime (a local inference server; see models/manifests/qwen3-asr.yaml).
NOTELY_ASR_URL=http://localhost:9000
NOTELY_ASR_MODEL=qwen3-asr
NOTELY_ASR_TIMEOUT_SECS=600

# --- Engine ---
# Where the engine stores its SQLite DB and generated artifacts (outside the repo).
# Defaults to an OS app-data dir, e.g. ~/Library/Application Support/ai.notely on macOS.
# NOTELY_DATA_DIR=/absolute/path/to/notely-data
# tracing filter, e.g. "info" or "notely_engine=debug".
NOTELY_LOG_LEVEL=info
# Loopback address the IPC server binds to.
NOTELY_IPC_ADDR=127.0.0.1:8765
